apiVersion: v1
kind: Secret
metadata:
  name: {{ .Values.disSecret.name }}
  labels:
    app.kubernetes.io/name: {{ include "dis.name" . }}
    app.kubernetes.io/instance: {{ .Release.Name }}
type: Opaque
stringData:
  # Hardcoding the keys (SOURCE_API_KEY) makes the Python os.environ logic "zero-debug"
  SOURCE_API_KEY: {{ .Values.disSecret.sourceApiValue | default "dev-api-key" | quote }}
  JWT_SECRET: {{ .Values.disSecret.jwtValue | default "dev-jwt-secret" | quote }}